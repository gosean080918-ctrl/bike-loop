# ============================================================
# BIKE LOOP — files kept out of the repository
# ============================================================
# Most important: no secret key may ever reach this repository.
#   server/.env holds the Kakao REST key.
#   The Supabase publishable key and the Kakao JavaScript key that live
#   in the app ARE committed: they are client-side keys protected by RLS
#   and by domain restrictions. See the security section of README.md.
# ============================================================

# ---------- Secrets and credentials ----------
.env
*.env
!*.env.example
server/.env
*.keystore
*.jks
key.properties
google-services.json
GoogleService-Info.plist
service-account*.json

# ---------- Build output (large) ----------
build/
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
*.apk
*.aab
*.ipa
*.app
*.dSYM.zip

# ---------- Flutter / Dart ----------
.dart_tool/
.packages
.pub-cache/
.pub/
doc/api/
*.g.dart.lock

# ---------- Android ----------
app/android/.gradle/
app/android/local.properties
app/android/app/release/
*.hprof

# ---------- iOS / macOS ----------
app/ios/Pods/
app/ios/.symlinks/
app/ios/Flutter/Flutter.framework
app/ios/Flutter/Flutter.podspec
app/ios/Flutter/Generated.xcconfig
app/ios/Flutter/flutter_export_environment.sh
app/ios/Runner.xcworkspace/xcuserdata/
app/ios/Runner.xcodeproj/xcuserdata/
app/macos/Pods/

# ---------- Python (optimization server) ----------
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# ---------- Raw analysis data (large) ----------
# The results report (RESULTS.md) and its charts are committed; the
# downloaded source CSVs are not. They can be re-fetched from NYC 311.
analysis-server/**/*.csv
analysis-server/**/raw/
analysis-server/**/cache/

