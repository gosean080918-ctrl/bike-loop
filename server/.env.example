# BIKE LOOP 최적화 서버 환경변수 (예시)
# 실제 값이 담긴 .env 는 절대 저장소에 올리지 않습니다.
# 이 파일을 복사해서 .env 로 만들고 값을 채우세요.
#
#   copy .env.example .env      (Windows)
#   cp   .env.example .env      (macOS/Linux)

# ---------- 카카오 (필수) ----------
# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > REST API 키
# ※ 앱에 넣지 말 것. 서버에만 둡니다.
KAKAO_REST_KEY=

# 도로 경로(다중 경유지)용. 위 REST 키와 같은 값을 쓰면 됩니다.
# 비워두면 직선거리(하버사인)로 폴백합니다.
KAKAO_MOBILITY_KEY=

# ---------- 접근 통제 (필수 — 일반 공개 시) ----------
# 서버는 '로그인한 앱 사용자'만 호출할 수 있어야 합니다.
# 앱이 보낸 Supabase 토큰을 이 주소로 확인합니다.
# Supabase 대시보드 > Project Settings > API 에서 확인
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# 한 사용자가 1분에 호출할 수 있는 횟수 (기본 60)
RATE_LIMIT_PER_MIN=60

# 토큰 검증 결과 캐시 시간(초). 짧을수록 안전, 길수록 빠름 (기본 300)
AUTH_CACHE_SECONDS=300

# ⚠ 로컬 개발에서만 사용. 운영에 절대 넣지 마세요 (인증이 완전히 꺼집니다)
# AUTH_DISABLED=true

# ---------- 최적화 엔진 튜닝 (선택) ----------
# 값을 비우면 engine.py 기본값이 적용됩니다.

# 같은 덩어리로 묶을 반경(m)
OPT_CLUSTER_RADIUS_M=30

# 한 지점에 정차했을 때 걸리는 시간(분)
OPT_CLUSTER_STOP_MINUTES=3

# 긴급도 기준 일수
OPT_CRITICAL_DAYS=90
OPT_HIGH_DAYS=60
OPT_MEDIUM_DAYS=30

# 평균 주행 속도(km/h) — 이동시간 추정에 사용
OPT_AVG_SPEED_KMH=40
